# Supabase project: ConsultTrack (ref xruquzbkwuuziujuivrg)
SUPABASE_URL=https://xruquzbkwuuziujuivrg.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Supabase Dashboard -> Connect -> Session pooler. URL-encode special characters
# in the database password.
DATABASE_URL=postgresql://postgres.xruquzbkwuuziujuivrg:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Addresses allowed to register even though they are not HAU ones, comma
# separated. Add ":adviser" to an entry to register it as a faculty account --
# the only way to test the adviser flow without an @hau.edu.ph address.
# Leave empty in production.
#   AUTH_EMAIL_ALLOWLIST=you@gmail.com:adviser,panelist@gmail.com
AUTH_EMAIL_ALLOWLIST=

# Campus wall-clock zone. Consultation hours are stored as plain times ("13:00"
# means 1 PM on campus, every week), and this is what turns one of them plus a
# calendar date into a real timestamp. Change it only if the campus moves.
CAMPUS_TIMEZONE=Asia/Manila
